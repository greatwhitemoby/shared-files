# Copy to a real .env or set these in your hosting provider's dashboard.
# The password you and your partner will use to sign in.
SHARE_PASSWORD=choose-a-strong-password

# Random secret used to sign login cookies. Use a long random string.
SECRET_KEY=replace-with-a-long-random-string

# Max upload size in MB per file.
MAX_UPLOAD_MB=512

# ---- Optional: Cloudflare R2 (recommended for the free cloud hosting, so
# files survive restarts). If R2_ENDPOINT is set, files go to R2; otherwise
# they are stored on the local disk (DATA_DIR).
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=your-bucket-name

# Local storage directory (used when R2 is not configured).
DATA_DIR=./data
